# Copy this file to .env and fill in your real values.
# Never commit .env to Git.

OPENAI_API_KEY=your-openai-api-key-here

# WhatsApp Cloud API (from Meta Developer Console → Your App → WhatsApp → API Setup)
WHATSAPP_TOKEN=your-whatsapp-temporary-or-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WEBHOOK_VERIFY_TOKEN=your-random-verify-token-same-as-in-meta-webhook-config

# Optional: your public base URL (e.g. from ngrok: https://xxxx.ngrok-free.app).
# When set, the app prints the full Callback URL for Meta on startup.
# APP_PUBLIC_URL=https://xxxx.ngrok-free.app
